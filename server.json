{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "org.agentvegan/public-data",
  "title": "Agent Vegan",
  "description": "Recettes illustrées, nutrition, ingrédients, substitutions et magasins en France",
  "version": "2.0.15",
  "repository": {
    "url": "https://github.com/ncleton-petitmaker/agentvegan-public-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.agentvegan.org/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@agentvegan/public-data-mcp",
      "version": "2.0.15",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp-stdio"
        }
      ]
    }
  ]
}
