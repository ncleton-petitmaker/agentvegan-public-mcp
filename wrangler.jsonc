{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentvegan-public-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./exports",
    "binding": "EXPORTS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "mcp.agentvegan.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "PUBLIC_DATA",
      "database_name": "agentvegan-public-data-v1-660ac999953893cc",
      "database_id": "9e77d038-e3b6-4b88-8aa9-95cd2bd263a3",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "limits": {
    "cpu_ms": 1000
  }
}
